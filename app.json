{
  "expo": {
    "name": "nudge_app",
    "slug": "Nudge",
    "version": "1.0.0",
    "orientation": "portrait",
    "notification": {
      "icon": "./assets/images/nudge.png",
      "color": "#2F3A36",
      "iosDisplayInForeground": true
    },
    "icon": "./assets/images/nudge.png",
    "scheme": "nudgeapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/nudge.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bipanabam.nudge_app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nudge.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c157c4d1-276f-4af7-9d07-384bd639ba16"
      }
    }
  }
}
